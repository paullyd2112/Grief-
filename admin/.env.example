# Supabase project — same project as the mobile app.
# The admin console uses the same anon key + RLS. Admin access is
# determined by the admins table, not by a different key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. Used by the daily retention job (/api/cron/retention) to purge
# expired reports, remove deleted audio, and hard-delete accounts. Never
# expose it to the browser: no NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Any long random string. Vercel sends it to cron routes as a bearer token.
CRON_SECRET=generate-a-long-random-string
