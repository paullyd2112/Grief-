# Create a .env file with your Supabase project details.
# These are public (anon) keys — safe to ship in the client bundle.
# RLS is what protects the data, not the key.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Shown to suspended and warned users so they can appeal. Optional; omitted if unset.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Link to the full Code of Conduct, shown under the guidelines summary.
# Optional; omitted if unset.
EXPO_PUBLIC_CODE_OF_CONDUCT_URL=

# Public links to the Privacy Policy and Terms of Service, shown in Settings.
# Apple requires a privacy policy URL; set both for any App Store build.
# Optional; omitted if unset.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
